{
  "$comment": "Recommended Claude Code project permissions for the agent org. The owner reviews this, then copies it to .claude/settings.json (AGENTS.md section 14). Deny rules are a speed bump, not a wall; the GitHub ruleset is what protects main.",
  "permissions": {
    "allow": [
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git switch *)", "Bash(git checkout *)",
      "Bash(git branch *)", "Bash(git fetch *)", "Bash(git rebase *)", "Bash(git worktree *)",
      "Bash(git push -u origin *)", "Bash(git push --force-with-lease *)",
      "Bash(gh issue *)", "Bash(gh pr *)", "Bash(gh run *)", "Bash(gh label list *)",
      "Bash(uv *)", "Bash(python3 tools/*)",
      "Bash(npm ci)", "Bash(npm run *)", "Bash(npm test *)", "Bash(npx tsc *)",
      "Bash(cargo build *)", "Bash(cargo test *)", "Bash(spacetime *)"
    ],
    "deny": [
      "Bash(git push origin main)", "Bash(git push origin main *)",
      "Bash(git push --force *)", "Bash(git push -f *)",
      "Bash(gh repo delete *)", "Bash(gh pr merge --admin *)",
      "Read(./.env)", "Read(./.env.local)"
    ]
  }
}
