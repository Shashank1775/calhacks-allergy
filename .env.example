# Copy to .env and fill in. Never commit .env. Agents read values from the environment only.

# SpacetimeDB (OQ-7: local standalone by default)
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_DB_NAME=kitchen

# Raspberry Pi (perception, gate)
PI_HOST=raspberrypi.local

# Laya: our fine-tuned copy of convaiinnovations/laya. Point at a laya-serve URL, or at a local checkpoint folder.
LAYA_ENDPOINT=
LAYA_MODEL_DIR=

# Cartesia: Ink (speech-to-text, intake) and Sonic (text-to-speech, experience)
CARTESIA_API_KEY=

# Apify (optional menu import)
APIFY_TOKEN=
