# Copy to .env and fill in. Never commit .env. Agents read values from the environment only.

# SpacetimeDB, running locally
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_DB_NAME=allergen-yhz81

# Raspberry Pi (vision, gate)
PI_HOST=raspberrypi.local

# Laya: our fine-tuned copy of convaiinnovations/laya, run locally. Point at the checkpoint folder
# (e.g. data/models/laya-v1); leave it empty to parse notes with the keyword fake.
LAYA_MODEL_DIR=

# Orders API (kitchen/orders/api.py)
ORDERS_PORT=8001
ORDERS_CORS_ORIGINS=http://localhost:5173

# Cartesia: Ink (speech-to-text, orders) and Sonic (text-to-speech, gate)
CARTESIA_API_KEY=
