{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "allergen_reach.schema.json",
  "title": "AllergenReach",
  "description": "One allergen that may have reached a plate, with its probability and the chain back to its source. Returned by the partner graph's exact reachability (ProvenanceGraph.reach). Consumer: verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allergen_unit_id",
    "probability",
    "chain"
  ],
  "properties": {
    "allergen_unit_id": {
      "$ref": "common.schema.json#/$defs/allergen_unit_id"
    },
    "probability": {
      "$ref": "common.schema.json#/$defs/probability"
    },
    "chain": {
      "type": "array",
      "items": {
        "$ref": "chain_step.schema.json"
      }
    }
  }
}
