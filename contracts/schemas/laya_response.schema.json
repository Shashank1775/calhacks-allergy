{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "laya_response.schema.json",
  "title": "LayaResponse",
  "description": "Laya's answer: which allergens reached the plate, and the chain back to each source. Producer: Laya model. Consumer: verdict policy (may only tighten, invariant 2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "plate_id",
    "allergens",
    "latency_ms"
  ],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "plate_id": {
      "$ref": "common.schema.json#/$defs/entity_id"
    },
    "allergens": {
      "type": "array",
      "items": {
        "$ref": "allergen_reach.schema.json"
      }
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
