{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "laya_request.schema.json",
  "title": "LayaRequest",
  "description": "The plate's time-forward ancestor subgraph, sent to Laya. Producer: verdict (from the partner graph's subgraph query). Consumer: the Laya model (trained by sim).",
  "type": "object",
  "additionalProperties": false,
  "required": ["plate_id", "ticket_id", "as_of_t_ms", "forbidden", "nodes", "edges"],
  "properties": {
    "plate_id": { "$ref": "common.schema.json#/$defs/entity_id" },
    "ticket_id": { "type": "string" },
    "as_of_t_ms": { "$ref": "common.schema.json#/$defs/t_ms" },
    "forbidden": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/allergen_unit_id" } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "kind", "label", "initial_profile"],
        "properties": {
          "entity_id": { "$ref": "common.schema.json#/$defs/entity_id" },
          "kind": { "$ref": "common.schema.json#/$defs/entity_kind" },
          "label": { "type": "string" },
          "initial_profile": { "$ref": "allergen_profile.schema.json" }
        }
      }
    },
    "edges": {
      "description": "Time-ordered. Same shape as interaction_event minus classifier and evidence.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "t_start_ms", "a_id", "b_id", "action", "probability", "direction"],
        "properties": {
          "event_id": { "type": "string" },
          "t_start_ms": { "$ref": "common.schema.json#/$defs/t_ms" },
          "a_id": { "$ref": "common.schema.json#/$defs/entity_id" },
          "b_id": { "$ref": "common.schema.json#/$defs/entity_id" },
          "action": { "$ref": "common.schema.json#/$defs/action" },
          "probability": { "$ref": "common.schema.json#/$defs/probability" },
          "direction": { "enum": ["a_to_b", "b_to_a", "both"] }
        }
      }
    }
  }
}
