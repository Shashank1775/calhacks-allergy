{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mistake_pattern.schema.json",
  "title": "MistakePattern",
  "description": "A recurring contamination path, grouped by source, tool type and allergen. Producer: provenance. Consumer: experience (Repeated Mistakes view).",
  "type": "object",
  "additionalProperties": false,
  "required": ["pattern_id", "allergen_unit_id", "source_entity_id", "source_label", "via_kind", "occurrences", "first_t_ms", "last_t_ms", "example_verdict_ids", "suggested_fix"],
  "properties": {
    "pattern_id": { "type": "string" },
    "allergen_unit_id": { "$ref": "common.schema.json#/$defs/allergen_unit_id" },
    "source_entity_id": { "$ref": "common.schema.json#/$defs/entity_id" },
    "source_label": { "type": "string" },
    "via_kind": { "type": "string", "description": "Tool class or entity kind the allergen travels through, e.g. knife, hand." },
    "occurrences": { "type": "integer", "minimum": 1 },
    "shifts": { "type": "integer", "minimum": 1 },
    "first_t_ms": { "$ref": "common.schema.json#/$defs/t_ms" },
    "last_t_ms": { "$ref": "common.schema.json#/$defs/t_ms" },
    "example_verdict_ids": { "type": "array", "items": { "type": "string" } },
    "suggested_fix": { "type": "string" }
  }
}
