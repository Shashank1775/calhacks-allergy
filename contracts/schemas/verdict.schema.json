{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict.schema.json",
  "title": "Verdict",
  "description": "The pass/hold decision for one plate against one ticket revision, computed in plain code from the partner graph's reachability. Producer: verdict. Consumers: outputs (gate, voice, expo board), verdict mistakes analysis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict_id",
    "ticket_id",
    "ticket_revision",
    "plate_id",
    "decided_t_ms",
    "trigger",
    "decision",
    "confidence",
    "pass_threshold",
    "reasons",
    "flagged",
    "chain",
    "versions"
  ],
  "properties": {
    "verdict_id": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string"
    },
    "ticket_revision": {
      "type": "integer",
      "minimum": 1
    },
    "plate_id": {
      "$ref": "common.schema.json#/$defs/entity_id"
    },
    "decided_t_ms": {
      "$ref": "common.schema.json#/$defs/t_ms"
    },
    "trigger": {
      "enum": [
        "plate_at_pass",
        "ticket_amended",
        "late_edge"
      ],
      "description": "What made the verdict service judge the plate: it reached the pass, its ticket was amended, or an interaction edge was recorded that starts at or before the plate's latest verdict (late_edge), so that verdict may have missed it. Every judgment reads the plate's full history again."
    },
    "decision": {
      "enum": [
        "pass",
        "hold"
      ]
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/probability",
      "description": "Clean-confidence: how sure we are the plate carries no forbidden allergen."
    },
    "pass_threshold": {
      "$ref": "common.schema.json#/$defs/probability"
    },
    "reasons": {
      "description": "Every reason to hold. Empty if and only if decision is pass.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "enum": [
              "forbidden_allergen",
              "low_confidence",
              "unknown_history",
              "stale_track",
              "missing_input",
              "error",
              "laya_flagged",
              "laya_unavailable"
            ]
          },
          "allergen_unit_id": {
            "$ref": "common.schema.json#/$defs/allergen_unit_id"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "flagged": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allergen_unit_id",
          "probability"
        ],
        "properties": {
          "allergen_unit_id": {
            "$ref": "common.schema.json#/$defs/allergen_unit_id"
          },
          "probability": {
            "$ref": "common.schema.json#/$defs/probability"
          }
        }
      }
    },
    "chain": {
      "type": "array",
      "items": {
        "$ref": "chain_step.schema.json"
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "graph"
      ],
      "properties": {
        "policy": {
          "type": "string"
        },
        "graph": {
          "type": "string"
        },
        "classifier": {
          "type": "string"
        },
        "laya": {
          "type": "string",
          "description": "The plate-check Laya checkpoint that judged this plate."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "reasons": {
            "maxItems": 0
          },
          "flagged": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "hold"
          }
        }
      },
      "then": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
